    "# Demonstrate adding and updating dictionary entries.\n",
    "\n",
    "data = {\"a\": 1, \"b\": 2}\n",
    "\n",
    "data[\"c\"] = 3\n",
    "data[\"a\"] = 10\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    print(\"Updated dictionary:\", data)"
