   "source": [
    "# Use get() and setdefault() for safe key access.\n",
    "\n",
    "user = {\"name\": \"Carol\"}\n",
    "\n",
    "age = user.get(\"age\", 30)\n",
    "user.setdefault(\"city\", \"London\")\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    print(\"User dictionary:\", user)\n",
    "    print(\"Age (default if missing):\", age)"
   ]
