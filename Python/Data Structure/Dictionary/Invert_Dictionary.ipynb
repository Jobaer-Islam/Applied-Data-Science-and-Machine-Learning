   "source": [
    "# Invert keys and values of a dictionary.\n",
    "\n",
    "mapping = {\"a\": 1, \"b\": 2, \"c\": 3}\n",
    "inverted = {v: k for k, v in mapping.items()}\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    print(\"Original:\", mapping)\n",
    "    print(\"Inverted:\", inverted)"
   ]
  },
