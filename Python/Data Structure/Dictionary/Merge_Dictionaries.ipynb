   "source": [
    "# Combine two dictionaries using unpacking and update methods.\n",
    "\n",
    "a = {\"x\": 1, \"y\": 2}\n",
    "b = {\"y\": 3, \"z\": 4}\n",
    "\n",
    "merged = {**a, **b}\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    print(\"Merged dictionary:\", merged)"
   ]
