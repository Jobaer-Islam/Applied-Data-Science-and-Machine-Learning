   "source": [
    "# Demonstrate dictionary comprehensions.\n",
    "\n",
    "squares = {x: x*x for x in range(6)}\n",
    "cubes = {y: y**3 for y in range(6)}\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    print(\"Squares dictionary:\", squares, sep=\"\\n\")\n",
    "    print(\"Cubes dictionary:\", cubes, sep=\"\\n\")"
