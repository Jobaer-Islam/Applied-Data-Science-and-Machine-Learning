   "source": [
    "# Count the frequency of elements using a dictionary.\n",
    "\n",
    "words = [\"apple\", \"banana\", \"apple\", \"orange\", \"banana\", \"apple\"]\n",
    "\n",
    "freq = {}\n",
    "for word in words:\n",
    "    freq[word] = freq.get(word, 0) + 1\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    print(\"Word frequencies:\", freq)"
   ]
